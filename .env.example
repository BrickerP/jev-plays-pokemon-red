# Put your TypeSafe key here. This is the only secret the project needs.
# Get one at https://typesafe.ai, then: cp .env.example .env and fill it in.
# .env is gitignored. Never commit the real key.
TYPESAFE_API_KEY=

# Your own legally obtained Pokemon Red dump. Never in this repo.
# Also passable per run as --rom <path>.
POKEMON_ROM=

# Optional. Point at a proxy or a local fake instead of https://api.typesafe.ai.
JEV_BASE_URL=
